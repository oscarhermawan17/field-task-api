# HTTP API
PORT=8080

# Authentication (development only — use a randomly generated secret in real deployments)
AUTH_JWT_SECRET=replace-this-with-a-secret-of-at-least-32-characters
AUTH_SEED_PASSWORD=password123

# PostgreSQL (used by Docker Compose now and by the Go API in the next database task)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=field_task
POSTGRES_USER=field_task
POSTGRES_PASSWORD=field_task_dev_password
